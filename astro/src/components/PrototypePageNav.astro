---
interface Props {
  current: "prototypes" | "homepage" | "article";
}

const { current } = Astro.props;
---

<nav class="prototype-page-nav" aria-label="Design pages">
  <a href="/dev/prototypes/" aria-current={current === "prototypes" ? "page" : undefined}>Prototypes</a>
  <a href="/dev/prototypes/style/" aria-current={current === "homepage" ? "page" : undefined}>Homepage</a>
  <a href="/post/" aria-current={current === "article" ? "page" : undefined}>Blog post</a>
  <a href="/">Website</a>
</nav>

<style>
  :global(:root) {
    --z-floating-nav: 100;
  }

  .prototype-page-nav {
    position: fixed;
    z-index: var(--z-floating-nav);
    inset-block-start: calc(12px + env(safe-area-inset-top));
    inset-inline-end: calc(12px + env(safe-area-inset-right));
    display: flex;
    gap: 2px;
    max-width: calc(100vw - 24px);
    padding: 4px;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 999px;
    background: rgb(10 10 10 / 88%);
    box-shadow: 0 8px 24px rgb(0 0 0 / 24%), 0 2px 6px rgb(0 0 0 / 12%);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    line-height: 1;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
  }

  .prototype-page-nav a {
    display: flex;
    min-width: 80px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding-inline: 16px;
    border-radius: 999px;
    color: rgb(255 255 255 / 65%);
    text-decoration: none;
    touch-action: manipulation;
    transition: color 150ms ease-out, background-color 150ms ease-out;
  }

  .prototype-page-nav a[aria-current="page"] {
    background: rgb(255 255 255 / 12%);
    color: #fff;
  }

  .prototype-page-nav a:focus-visible {
    outline: 2px solid rgb(255 255 255 / 70%);
    outline-offset: 2px;
  }

  .prototype-page-nav a:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .prototype-page-nav a:hover {
      color: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prototype-page-nav a {
      transition: none;
    }
  }
</style>
