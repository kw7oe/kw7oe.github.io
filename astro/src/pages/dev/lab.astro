---
const meta = {
  title: 'ASCII Lab — Kai Wern',
  description: 'Turn a photograph into a colour-cell ASCII study. Upload locally, tune the palette and ink, export a PNG or HTML.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#ebe5df" />
    <title>{meta.title}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Kai Wern home">KW<span>.</span></a>
        <nav aria-label="Primary navigation">
          <a href="https://kaiwern.com/posts/">Posts</a>
          <a href="https://kaiwern.com/fragments/">Fragments</a>
          <a href="https://kaiwern.com/about/">About</a>
          <a href="/dev/exploration/">Exploration</a>
          <a href="/dev/lab/" aria-current="page">Lab</a>
        </nav>
      </header>

      <main id="main-content">
        <section class="intro" aria-labelledby="lab-title">
          <p class="eyebrow">ASCII Lab · photo study</p>
          <h1 id="lab-title">Photo, <span>in characters</span>.</h1>
          <p class="intro-copy">
            Drop a photograph. It is resampled into a grid of coloured cells,
            then each cell picks a character from its luminance. Tune the palette,
            ink, and resolution in the panel.
          </p>
        </section>

        <div class="workbench">
          <section class="stage" aria-label="ASCII preview">
            <div class="stage-head">
              <span id="file-label" class="file-label">No photograph yet</span>
              <span id="metrics" class="metrics">—</span>
            </div>

            <div id="dropzone" class="dropzone">
              <div id="empty" class="empty">
                <p class="empty-title">Drop a photograph</p>
                <p class="empty-copy">JPEG, PNG or WebP. It stays in your browser.</p>
                <div class="empty-actions">
                  <button id="choose" class="button primary" type="button">Choose a photo</button>
                  <button id="sample" class="button ghost" type="button">Try the Lake sample</button>
                </div>
              </div>
              <pre id="art" class="art" aria-hidden="true" hidden></pre>
            </div>

            <div class="stage-actions">
              <button id="replace" class="button" type="button" disabled>Replace photo</button>
              <button id="download" class="button" type="button" disabled>Download PNG</button>
              <button id="copy" class="button" type="button" disabled>Copy HTML</button>
              <span id="status" class="status" role="status" aria-live="polite"></span>
            </div>
          </section>

          <aside class="panel" aria-label="Controls">
            <div class="panel-head">
              <h2>Tune</h2>
              <span>DialKit</span>
            </div>
            <div class="presets">
              <span class="preset-label">Palette</span>
              <button class="chip" type="button" data-preset="lake">Lake</button>
              <button class="chip" type="button" data-preset="duotone">Duotone</button>
              <button class="chip" type="button" data-preset="mono">Mono</button>
              <button class="chip" type="button" id="from-photo">From photo</button>
              <button class="chip" type="button" id="reset">Reset</button>
            </div>
            <div id="dialkit" class="dialkit"></div>
            <p class="panel-note">
              Colours are sampled from the photo. The slider sets how many are used;
              edit any swatch, or use From photo to resample. Ink changes the
              character density, not the palette. Tall photos cap at 220 rows.
              In Method, Ink paints the photograph as a wash and inks the glyph
              over it, Shape picks each glyph by a 2 × 3 read of the cell,
              Bleed lets the glyph fill the cell, and Gaps puts the grid in the
              paper. Measured, Blanks and Edges are the earlier switches. Turn
              all of them off to see the plain luminance tiles.
            </p>
          </aside>
        </div>

        <p class="sample-credit">
          Sample: <a href="https://commons.wikimedia.org/wiki/File:Panorama_of_Brienzersee.jpg">Panorama of Brienzersee</a>
          (cropped) by Nicojonesgodel, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>,
          via Wikimedia Commons. Uploads are processed locally.
        </p>
      </main>

      <footer class="site-footer">
        <span>Made with care.</span>
        <a href="https://kaiwern.com/about/">More about Kai <span aria-hidden="true">↗</span></a>
      </footer>
    </div>

    <input id="file" type="file" accept="image/*" hidden />

    <script>
      import { createDialKit, createDialRoot } from 'dialkit/vanilla';
      import 'dialkit/vanilla/styles.css';

      const CHARS = ['.', ':', ';', 'o', '0', '8', '#', '@'];
      const RAMP_POOL = ['.', ':', ';', '+', '*', 'x', 'o', '0', '8', '#', '%', '@', '&'];
      const STROKES = ['-', '\\', '|', '/'];
      // Shape matching needs glyphs that mark a sub-cell edge, not only tone.
      const SHAPE_CHARS = [...RAMP_POOL, ...STROKES, '_'];
      const SUB = 4;
      const ART_FONT = 'ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace';
      const COLOUR_KEYS = Array.from({ length: 8 }, (_, i) => `colour${i + 1}`);
      const PRESETS = {
        lake: ['#f7f2ea', '#e7eee9', '#d3e1dd', '#b5cfcb', '#96b9b7', '#6f9aa1', '#3c6d84', '#262a33'],
        duotone: ['#f7f2ea', '#e6eeeb', '#d2e0dd', '#b8cecb', '#9bbcc0', '#7aa3ab', '#5f93a3', '#2c3d44'],
        mono: ['#f7f3ec', '#e4e0d7', '#d0cbc2', '#b9b3aa', '#a09a91', '#807b78', '#5b5660', '#26232b'],
      };
      const clampCount = (n) => Math.max(2, Math.min(8, Math.round(n)));
      const METHOD_DEFAULTS = {
        ink: true,
        shape: true,
        bleed: true,
        gaps: true,
        measured: true,
        blanks: true,
        edges: true,
        grid: false,
        wash: 0.8,
        blankAt: 0.94,
      };

      const dropzone = document.querySelector('#dropzone');
      const empty = document.querySelector('#empty');
      const art = document.querySelector('#art');
      const fileInput = document.querySelector('#file');
      const fileLabel = document.querySelector('#file-label');
      const metrics = document.querySelector('#metrics');
      const status = document.querySelector('#status');
      const downloadButton = document.querySelector('#download');
      const copyButton = document.querySelector('#copy');
      const replaceButton = document.querySelector('#replace');

      let bitmap = null;
      let sampled = null;
      let lastRender = null;
      let currentHtml = '';
      let frame = 0;
      let fileName = 'photo';
      let pendingPalette = false;
      let lastCount = 5;

      const colorCanvas = document.createElement('canvas');
      colorCanvas.width = 1;
      colorCanvas.height = 1;
      const colorContext = colorCanvas.getContext('2d', { willReadFrequently: true });

      function rgbOf(css) {
        colorContext.fillStyle = '#000000';
        colorContext.fillStyle = css;
        colorContext.fillRect(0, 0, 1, 1);
        const [r, g, b] = colorContext.getImageData(0, 0, 1, 1).data;
        return [r, g, b];
      }

      function hexOf([r, g, b]) {
        return '#' + [r, g, b].map((n) => n.toString(16).padStart(2, '0')).join('');
      }

      function luminance([r, g, b]) {
        return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
      }

      function setStatus(message) {
        status.textContent = message;
      }

      const root = createDialRoot({
        mode: 'inline',
        target: document.querySelector('#dialkit'),
        theme: 'light',
      });

      const kit = createDialKit(
        'ASCII Lab',
        {
          colours: [5, 2, 8, 1],
          ink: [1, 0.4, 1.8, 0.05],
          columns: [200, 90, 300, 10],
          palette: Object.fromEntries(
            COLOUR_KEYS.map((key, i) => [key, { type: 'color', default: PRESETS.lake[i] }]),
          ),
          paper: { type: 'color', default: '#f6f1ea' },
          method: {
            ink: METHOD_DEFAULTS.ink,
            shape: METHOD_DEFAULTS.shape,
            bleed: METHOD_DEFAULTS.bleed,
            gaps: METHOD_DEFAULTS.gaps,
            measured: METHOD_DEFAULTS.measured,
            blanks: METHOD_DEFAULTS.blanks,
            edges: METHOD_DEFAULTS.edges,
            grid: METHOD_DEFAULTS.grid,
            wash: [METHOD_DEFAULTS.wash, 0.08, 1, 0.02],
            blankAt: [METHOD_DEFAULTS.blankAt, 0.8, 1, 0.01],
          },
        },
        { id: 'ascii-lab', persist: true },
      );

      lastCount = clampCount(kit.values.colours);

      function schedule() {
        if (!sampled || frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const cols = Math.round(kit.values.columns);
          if (cols !== sampled.cols) resample();
          else render();
        });
      }

      function colourDistance(a, b) {
        return (a[0] - b[0]) ** 2 * 0.3 + (a[1] - b[1]) ** 2 * 0.59 + (a[2] - b[2]) ** 2 * 0.11;
      }

      function extractPalette(count) {
        if (!sampled) return null;
        const total = sampled.lum.length;
        const stride = Math.max(1, Math.floor(total / 4000));
        const samples = [];
        for (let i = 0; i < total; i += stride) {
          const p = i * 3;
          samples.push([sampled.rgb[p], sampled.rgb[p + 1], sampled.rgb[p + 2]]);
        }
        if (!samples.length) return null;

        const mean = samples.reduce(
          (sum, color) => [sum[0] + color[0], sum[1] + color[1], sum[2] + color[2]],
          [0, 0, 0],
        ).map((value) => value / samples.length);

        const centers = [];
        let seed = samples[0];
        let seedDistance = -1;
        for (const color of samples) {
          const distance = colourDistance(color, mean);
          if (distance > seedDistance) {
            seedDistance = distance;
            seed = color;
          }
        }
        centers.push(seed);

        while (centers.length < count) {
          let best = samples[0];
          let bestDistance = -1;
          for (const color of samples) {
            let nearest = Infinity;
            for (const center of centers) {
              nearest = Math.min(nearest, colourDistance(color, center));
            }
            if (nearest > bestDistance) {
              bestDistance = nearest;
              best = color;
            }
          }
          centers.push(best);
        }

        for (let iteration = 0; iteration < 8; iteration += 1) {
          const sums = Array.from({ length: centers.length }, () => [0, 0, 0, 0]);
          for (const color of samples) {
            let index = 0;
            let nearest = Infinity;
            for (let c = 0; c < centers.length; c += 1) {
              const distance = colourDistance(color, centers[c]);
              if (distance < nearest) {
                nearest = distance;
                index = c;
              }
            }
            const sum = sums[index];
            sum[0] += color[0];
            sum[1] += color[1];
            sum[2] += color[2];
            sum[3] += 1;
          }
          for (let c = 0; c < centers.length; c += 1) {
            const sum = sums[c];
            if (sum[3]) centers[c] = [sum[0] / sum[3], sum[1] / sum[3], sum[2] / sum[3]];
          }
        }

        return centers
          .slice()
          .sort((a, b) => luminance(b) - luminance(a))
          .map((color) => hexOf(color.map(Math.round)));
      }


      function syncColourVisibility(count) {
        const active = clampCount(count);
        requestAnimationFrame(() => {
          const controls = [...document.querySelectorAll('#dialkit .dialkit-color-control')];
          const colours = controls.filter((el) => el.innerText.trim().toLowerCase().startsWith('colour'));
          colours.forEach((el, i) => {
            el.style.display = i < active ? '' : 'none';
          });
        });
      }

      function applyPhotoPalette() {
        if (!sampled) return false;
        const count = clampCount(kit.values.colours);
        const colors = extractPalette(count);
        if (!colors) return false;
        const palette = {};
        colors.forEach((color, i) => {
          palette[`colour${i + 1}`] = color;
        });
        kit.setValues({ palette });
        syncColourVisibility(count);
        schedule();
        return true;
      }

      const unsubscribe = kit.subscribe((values) => {
        const count = clampCount(values.colours);
        if (count !== lastCount) {
          lastCount = count;
          syncColourVisibility(count);
          if (sampled) applyPhotoPalette();
          else schedule();
        } else {
          schedule();
        }
      }, false);

      requestAnimationFrame(() => syncColourVisibility(lastCount));

      function clamp01(n) {
        return Math.max(0, Math.min(1, n));
      }

      let measuredRamp = null;

      function measureGlyphs(chars) {
        const size = 48;
        const canvas = document.createElement('canvas');
        canvas.width = size;
        canvas.height = size;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        ctx.font = `500 ${Math.round(size * 0.8)}px ${ART_FONT}`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        return chars
          .map((char) => {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, size, size);
            ctx.fillStyle = '#000000';
            ctx.fillText(char, size / 2, size / 2);
            const data = ctx.getImageData(0, 0, size, size).data;
            let sum = 0;
            for (let i = 0; i < data.length; i += 4) sum += data[i];
            return { char, ink: 1 - sum / (data.length / 4) / 255 };
          })
          .sort((a, b) => a.ink - b.ink);
      }

      // Order the ramp by measured ink rather than by eye, and pick the glyph
      // nearest the middle of each equal ink band so the steps are even.
      function calibratedRamp(count) {
        if (!measuredRamp) measuredRamp = measureGlyphs(RAMP_POOL);
        const lo = measuredRamp[0].ink;
        const hi = measuredRamp[measuredRamp.length - 1].ink;
        const ramp = [];
        for (let step = 0; step < count; step += 1) {
          const target = lo + ((hi - lo) * (step + 0.5)) / count;
          let best = null;
          for (const glyph of measuredRamp) {
            if (ramp.includes(glyph.char)) continue;
            if (!best || Math.abs(glyph.ink - target) < Math.abs(best.ink - target)) best = glyph;
          }
          if (best) ramp.push(best.char);
        }
        return ramp;
      }

      // Shape matching: render every candidate once into a cell-shaped slot,
      // sample it at 2 x 3 points, and compare that signature with the same
      // six points from the photograph. Six numbers are enough to tell a
      // diagonal edge from a soft blob, so "/" and "|" arrive without a
      // separate edge rule.
      const TAP_X = [0.27, 0.73];
      const TAP_Y = [0.2, 0.5, 0.8];
      let shapeSignatures = null;

      function measureShapes() {
        if (shapeSignatures) return shapeSignatures;
        const w = 40;
        const h = 72;
        const canvas = document.createElement('canvas');
        canvas.width = w * SHAPE_CHARS.length;
        canvas.height = h;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        ctx.fillStyle = '#000000';
        ctx.fillRect(0, 0, canvas.width, h);
        ctx.fillStyle = '#ffffff';
        ctx.textBaseline = 'alphabetic';
        ctx.font = `700 ${((w / 0.6) * 0.95).toFixed(2)}px ${ART_FONT}`;
        SHAPE_CHARS.forEach((char, g) => {
          ctx.save();
          ctx.beginPath();
          ctx.rect(g * w, 0, w, h);
          ctx.clip();
          ctx.fillText(char, g * w, h * 0.82);
          ctx.restore();
        });
        const data = ctx.getImageData(0, 0, canvas.width, h).data;
        const raw = SHAPE_CHARS.map((char, g) => {
          const sig = [];
          for (const fy of TAP_Y) {
            for (const fx of TAP_X) {
              const px = Math.min(w - 1, Math.max(0, Math.floor(fx * w)));
              const py = Math.min(h - 1, Math.max(0, Math.floor(fy * h)));
              sig.push(data[(py * canvas.width + g * w + px) * 4] / 255);
            }
          }
          let cover = 0;
          for (let yy = 0; yy < h; yy += 1) {
            for (let xx = 0; xx < w; xx += 1) {
              cover += data[(yy * canvas.width + g * w + xx) * 4];
            }
          }
          return { char, sig, ink: cover / (w * h * 255) };
        });
        for (let e = 0; e < 6; e += 1) {
          const peak = Math.max(...raw.map((glyph) => glyph.sig[e])) || 1;
          for (const glyph of raw) glyph.sig[e] /= peak;
        }
        const inks = raw.map((glyph) => glyph.ink);
        shapeSignatures = { glyphs: raw, inkMin: Math.min(...inks), inkMax: Math.max(...inks) };
        return shapeSignatures;
      }

      function shapeGlyph(i, t) {
        if (!sampled.taps) return null;
        const base = i * 6;
        let lo = 1;
        let hi = 0;
        for (let e = 0; e < 6; e += 1) {
          const v = sampled.taps[base + e];
          if (v < lo) lo = v;
          if (v > hi) hi = v;
        }
        // A flat cell has no shape to match; leave it to the tone ramp.
        if (hi - lo < 0.09) return null;
        const pattern = [];
        for (let e = 0; e < 6; e += 1) {
          pattern.push(1 - (sampled.taps[base + e] - lo) / (hi - lo));
        }
        // Shape only chooses between glyphs of a similar weight: tone still
        // decides how dark the cell is, the signature decides where the ink sits.
        const { glyphs, inkMin, inkMax } = measureShapes();
        const target = inkMin + clamp01(t) * (inkMax - inkMin);
        // Tone picks the weight, but strokes stay in the running at every
        // tone: a thin "-" in a dark band is still dark ink, and that is what
        // lets a ridge read as a line instead of a row of heavy glyphs.
        const nearest = [...glyphs]
          .sort((a, b) => Math.abs(a.ink - target) - Math.abs(b.ink - target))
          .slice(0, 6);
        const strokes = glyphs.filter((glyph) => '-\\|/_'.includes(glyph.char));
        const candidates = [...new Set([...nearest, ...strokes])];
        let best = null;
        let bestDistance = Infinity;
        for (const glyph of candidates) {
          let d = 0;
          for (let e = 0; e < 6; e += 1) {
            const q = pattern[e] - glyph.sig[e];
            d += q * q;
          }
          if (d < bestDistance) {
            bestDistance = d;
            best = glyph;
          }
        }
        return bestDistance <= 0.6 ? best.char : null;
      }

      // One continuous colour field at cell resolution, pre-blended with the
      // paper. Cheaper and smoother than a class per cell, and it is what makes
      // the wash read as paper rather than as coloured rectangles.
      function washImage(cols, rows, strength, paper) {
        const canvas = document.createElement('canvas');
        canvas.width = cols * 3;
        canvas.height = rows * 3;
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = paper;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.globalAlpha = strength;
        ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        return canvas.toDataURL('image/png');
      }

      function render() {
        if (!sampled) return;
        const values = kit.values;
        const method = { ...METHOD_DEFAULTS, ...values.method };
        const count = clampCount(values.colours);
        const palette = Array.from({ length: count }, (_, i) => {
          const rgb = rgbOf(values.palette[`colour${i + 1}`]);
          const lum = luminance(rgb);
          // Ink keeps the band's hue but flips against it: dark ink on light
          // paper, pale ink on a dark wash.
          const toward = lum > 0.4 ? [26, 32, 40] : [240, 247, 252];
          const inkRgb = rgb.map((v, j) => Math.round(v * 0.35 + toward[j] * 0.65));
          return { rgb, hex: hexOf(rgb), lum, ink: hexOf(inkRgb) };
        });
        const n = palette.length;
        const density = values.ink;
        const paper = values.paper;
        const rows = sampled.rows;
        const cols = sampled.cols;
        const lums = sampled.lum;
        const edges = sampled.edges;
        const range = Math.max(0.02, sampled.max - sampled.min);
        const ramp = method.measured ? calibratedRamp(8) : CHARS;
        const blankAt = method.blankAt;

        const bands = new Uint8Array(cols * rows);
        const blanks = new Uint8Array(cols * rows);
        const chars = new Array(cols * rows);
        const lines = [];

        for (let y = 0; y < rows; y += 1) {
          let runClass = null;
          let run = '';
          let line = '';
          const flush = () => {
            if (!run) return;
            line += `<span class="${runClass}">${run}</span>`;
            run = '';
          };
          for (let x = 0; x < cols; x += 1) {
            const i = y * cols + x;
            const normalized = clamp01((lums[i] - sampled.min) / range);
            const p = i * 3;
            let band = 0;
            let nearest = Infinity;
            for (let c = 0; c < n; c += 1) {
              const color = palette[c].rgb;
              const distance =
                (sampled.rgb[p] - color[0]) ** 2 * 0.3 +
                (sampled.rgb[p + 1] - color[1]) ** 2 * 0.59 +
                (sampled.rgb[p + 2] - color[2]) ** 2 * 0.11;
              if (distance < nearest) {
                nearest = distance;
                band = c;
              }
            }
            bands[i] = band;
            let glyph = ' ';
            let cls = `q${band}`;
            if (method.blanks && normalized >= blankAt) {
              blanks[i] = 1;
              cls = `q${band} qb`;
            } else {
              const ink = (1 - normalized) * density;
              const t = clamp01((ink - 0.02) / 0.98);
              const shaped = method.shape ? shapeGlyph(i, t) : null;
              glyph =
                shaped ??
                (method.edges && edges[i] < STROKES.length
                  ? STROKES[edges[i]]
                  : ramp[Math.min(ramp.length - 1, Math.floor(t * ramp.length))]);
            }
            chars[i] = glyph;

            if (cls !== runClass) {
              flush();
              runClass = cls;
            }
            run += glyph;
          }
          flush();
          lines.push(line);
        }
        currentHtml = lines.join('\n');

        for (let i = 0; i < n; i += 1) {
          art.style.setProperty(`--q${i}-bg`, palette[i].hex);
          art.style.setProperty(`--q${i}-fg`, palette[i].lum > 0.54 ? '#283138' : '#f8f4ed');
          art.style.setProperty(`--q${i}-ink`, palette[i].ink);
        }
        art.style.setProperty('--paper', paper);
        art.style.setProperty('--row', method.bleed ? '0.97em' : '1.08em');
        if (method.ink) {
          art.style.setProperty('--wash-img', `url("${washImage(cols, rows, method.wash, paper)}")`);
        } else {
          art.style.removeProperty('--wash-img');
        }
        art.style.fontSize = `clamp(2.2px, ${(164 / cols).toFixed(3)}cqi, 14px)`;
        art.innerHTML = currentHtml;
        art.classList.toggle('ink', Boolean(method.ink));
        art.classList.toggle('bleed', Boolean(method.bleed));
        art.classList.toggle('gaps', Boolean(method.gaps));
        art.classList.toggle('grid', Boolean(method.grid));
        lastRender = {
          cols,
          rows,
          bands,
          blanks,
          chars,
          palette,
          paper,
          density,
          wash: method.wash,
          method: { ...method },
        };
        metrics.textContent = `${cols} × ${rows} · ${(cols * rows).toLocaleString()} cells`;
        empty.hidden = true;
        art.hidden = false;
        downloadButton.disabled = false;
        copyButton.disabled = false;
        replaceButton.disabled = false;
        setStatus('');
      }

      function resample() {
        if (!bitmap) return;
        let cols = Math.max(60, Math.min(300, Math.round(kit.values.columns)));
        let rows = Math.round(cols * 0.5556 * (bitmap.height / bitmap.width));
        const MAX_ROWS = 220;
        if (rows > MAX_ROWS) {
          cols = Math.max(50, Math.round(cols * (MAX_ROWS / rows)));
          rows = Math.round(cols * 0.5556 * (bitmap.height / bitmap.width));
        }
        rows = Math.max(18, Math.min(MAX_ROWS, rows));
        const sw = cols * SUB;
        const sh = rows * SUB;
        const canvas = document.createElement('canvas');
        canvas.width = sw;
        canvas.height = sh;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        ctx.fillStyle = kit.values.paper;
        ctx.fillRect(0, 0, sw, sh);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(bitmap, 0, 0, sw, sh);
        const data = ctx.getImageData(0, 0, sw, sh).data;
        const lum = new Float32Array(cols * rows);
        const rgb = new Uint8ClampedArray(cols * rows * 3);
        const edges = new Uint8Array(cols * rows).fill(STROKES.length);
        const taps = new Float32Array(cols * rows * 6);
        const sub = new Float32Array(sw * sh);
        for (let i = 0, p = 0; i < sub.length; i += 1, p += 4) {
          sub[i] = (0.2126 * data[p] + 0.7152 * data[p + 1] + 0.0722 * data[p + 2]) / 255;
        }
        for (let y = 0; y < rows; y += 1) {
          for (let x = 0; x < cols; x += 1) {
            const i = y * cols + x;
            let sr = 0;
            let sg = 0;
            let sb = 0;
            let sl = 0;
            let lo = 1;
            let hi = 0;
            for (let sy = 0; sy < SUB; sy += 1) {
              for (let sx = 0; sx < SUB; sx += 1) {
                const p = ((y * SUB + sy) * sw + x * SUB + sx) * 4;
                const subLum = sub[(y * SUB + sy) * sw + x * SUB + sx];
                sr += data[p];
                sg += data[p + 1];
                sb += data[p + 2];
                sl += subLum;
                if (subLum < lo) lo = subLum;
                if (subLum > hi) hi = subLum;
              }
            }
            const cells = SUB * SUB;
            rgb[i * 3] = sr / cells;
            rgb[i * 3 + 1] = sg / cells;
            rgb[i * 3 + 2] = sb / cells;
            lum[i] = sl / cells;

            // The same 2 x 3 points the glyph signatures are measured at.
            for (let ty = 0; ty < TAP_Y.length; ty += 1) {
              for (let tx = 0; tx < TAP_X.length; tx += 1) {
                const sx2 = Math.min(SUB - 1, Math.floor(TAP_X[tx] * SUB));
                const sy2 = Math.min(SUB - 1, Math.floor(TAP_Y[ty] * SUB));
                taps[i * 6 + ty * 2 + tx] = sub[(y * SUB + sy2) * sw + x * SUB + sx2];
              }
            }

            const cx = x * SUB + 1;
            const cy = y * SUB + 1;
            const gx =
              sub[(cy - 1) * sw + cx + 1] +
              2 * sub[cy * sw + cx + 1] +
              sub[(cy + 1) * sw + cx + 1] -
              (sub[(cy - 1) * sw + cx - 1] +
                2 * sub[cy * sw + cx - 1] +
                sub[(cy + 1) * sw + cx - 1]);
            const gy =
              sub[(cy + 1) * sw + cx - 1] +
              2 * sub[(cy + 1) * sw + cx] +
              sub[(cy + 1) * sw + cx + 1] -
              (sub[(cy - 1) * sw + cx - 1] +
                2 * sub[(cy - 1) * sw + cx] +
                sub[(cy - 1) * sw + cx + 1]);
            // A stroke stands in where a line crosses the cell: the cell is
            // mostly one tone with a distinct minority of the other, which is
            // what a thin stem or a wave crest looks like. Soft gradients and
            // noise sit near the middle and are left to the ramp.
            const toLo = lum[i] - lo;
            const toHi = hi - lum[i];
            const minor = Math.min(toLo, toHi);
            const major = Math.max(toLo, toHi);
            if (hi - lo >= 0.35 && minor >= 0.15 && major >= 0.26 && major >= minor * 1.5) {
              const angle = ((Math.atan2(gy, gx) * 180) / Math.PI + 90 + 180) % 180;
              edges[i] = Math.round(angle / 45) % 4;
            }
          }
        }
        const sorted = Float32Array.from(lum).sort();
        const min = sorted[Math.floor(lum.length * 0.02)];
        const max = sorted[Math.floor(lum.length * 0.98)];
        sampled = { cols, rows, lum, rgb, edges, taps, min, max };
        if (pendingPalette) {
          pendingPalette = false;
          applyPhotoPalette();
        } else {
          render();
        }
      }

      async function useBitmap(nextBitmap, label) {
        bitmap = nextBitmap;
        fileName = label;
        fileLabel.textContent = label;
        replaceButton.disabled = false;
        pendingPalette = true;
        setStatus('Reading photograph…');
        await new Promise((resolve) => requestAnimationFrame(resolve));
        resample();
      }

      async function loadFile(file) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          setStatus('That file is not an image.');
          return;
        }
        if (file.size > 25 * 1024 * 1024) {
          setStatus('That image is larger than 25 MB.');
          return;
        }
        fileLabel.textContent = 'Reading photograph…';
        try {
          let nextBitmap;
          try {
            nextBitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
          } catch {
            nextBitmap = await createImageBitmap(file);
          }
          await useBitmap(nextBitmap, file.name.replace(/\.[^.]+$/, '') || 'photo');
        } catch (error) {
          console.error(error);
          setStatus('Could not read that image.');
          fileLabel.textContent = 'No photograph yet';
        }
      }

      function openPicker() {
        fileInput.click();
      }

      document.querySelector('#choose').addEventListener('click', (event) => {
        event.stopPropagation();
        openPicker();
      });
      replaceButton.addEventListener('click', openPicker);
      dropzone.addEventListener('click', (event) => {
        if (event.target.closest('button')) return;
        if (!bitmap) openPicker();
      });
      fileInput.addEventListener('change', () => {
        loadFile(fileInput.files?.[0]);
        fileInput.value = '';
      });

      for (const type of ['dragenter', 'dragover']) {
        dropzone.addEventListener(type, (event) => {
          event.preventDefault();
          dropzone.classList.add('dragging');
        });
      }
      for (const type of ['dragleave', 'drop']) {
        dropzone.addEventListener(type, (event) => {
          event.preventDefault();
          dropzone.classList.remove('dragging');
        });
      }
      dropzone.addEventListener('drop', (event) => {
        const file = event.dataTransfer?.files?.[0];
        if (file) loadFile(file);
      });

      document.querySelector('#sample').addEventListener('click', async (event) => {
        event.stopPropagation();
        setStatus('Loading sample…');
        try {
          const response = await fetch('/dev/lab/lake-sample.jpg');
          const blob = await response.blob();
          await loadFile(new File([blob], 'lake-sample.jpg', { type: blob.type }));
        } catch {
          setStatus('Could not load the sample.');
        }
      });

      for (const button of document.querySelectorAll('[data-preset]')) {
        button.addEventListener('click', () => {
          const count = clampCount(kit.values.colours);
          const ramp = PRESETS[button.dataset.preset];
          const palette = {};
          for (let i = 0; i < count; i += 1) {
            const maxIndex = count === 2 ? ramp.length - 2 : ramp.length - 1;
            const index = Math.round((i * maxIndex) / Math.max(1, count - 1));
            palette[`colour${i + 1}`] = ramp[index];
          }
          kit.setValues({ palette });
          syncColourVisibility(count);
          schedule();
        });
      }

      document.querySelector('#from-photo').addEventListener('click', () => {
        if (!sampled) {
          setStatus('Load a photo first.');
          return;
        }
        applyPhotoPalette();
      });

      document.querySelector('#reset').addEventListener('click', () => {
        kit.resetValues();
        lastCount = clampCount(kit.values.colours);
        if (sampled) applyPhotoPalette();
        else {
          syncColourVisibility(lastCount);
          schedule();
        }
      });

      function slug() {
        return (fileName || 'photo')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '')
          .slice(0, 48) || 'photo';
      }

      function downloadPng() {
        if (!lastRender) return;
        const { cols, rows, bands, blanks, chars, palette, paper, wash, method } = lastRender;
        const fontSize = Math.max(7, Math.min(12, 1400 / cols / 0.6));
        const cellW = fontSize * 0.6;
        const cellH = fontSize * (method.bleed ? 0.97 : 1.08);
        let scale = 2;
        if (cols * cellW * scale > 7000) scale = 1;
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(cols * cellW * scale);
        canvas.height = Math.round(rows * cellH * scale);
        const ctx = canvas.getContext('2d');
        ctx.scale(scale, scale);
        ctx.fillStyle = paper;
        ctx.fillRect(0, 0, cols * cellW, rows * cellH);

        if (method.ink) {
          ctx.globalAlpha = wash;
          ctx.drawImage(bitmap, 0, 0, cols * cellW, rows * cellH);
          ctx.globalAlpha = 1;
          if (method.gaps) {
            ctx.fillStyle = paper;
            for (let x = 0; x <= cols; x += 1) ctx.fillRect(x * cellW, 0, 1 / scale, rows * cellH);
            for (let y = 0; y <= rows; y += 1) ctx.fillRect(0, y * cellH, cols * cellW, 1 / scale);
          }
        }

        ctx.font = `${method.bleed ? 700 : 500} ${fontSize}px ui-monospace, "SF Mono", Menlo, Consolas, monospace`;
        ctx.textBaseline = 'top';
        for (let y = 0; y < rows; y += 1) {
          for (let x = 0; x < cols; x += 1) {
            const i = y * cols + x;
            if (blanks[i]) continue;
            const color = palette[bands[i]];
            if (method.ink) {
              ctx.fillStyle = color.ink;
            } else {
              ctx.fillStyle = color.hex;
              const gap = method.gaps ? 1 : 0;
              ctx.fillRect(x * cellW, y * cellH, Math.max(0, cellW - gap), Math.max(0, cellH - gap));
              ctx.fillStyle = color.lum > 0.54 ? '#283138' : '#f8f4ed';
            }
            ctx.fillText(chars[i], x * cellW, y * cellH);
          }
        }
        canvas.toBlob((blob) => {
          if (!blob) return;
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `${slug()}-ascii.png`;
          document.body.appendChild(link);
          link.click();
          link.remove();
          setTimeout(() => URL.revokeObjectURL(url), 2000);
          setStatus('PNG downloaded.');
        }, 'image/png');
      }

      async function copyHtml() {
        if (!lastRender || !currentHtml) return;
        const { cols, rows, palette, paper, wash, method } = lastRender;
        const rules = palette
          .map((color, i) =>
            method.ink
              ? `.ascii-lab .q${i}{color:${color.ink};}`
              : `.ascii-lab .q${i}{background:${color.hex};color:${color.lum > 0.54 ? '#283138' : '#f8f4ed'};}`,
          )
          .concat(
            method.ink
              ? '.ascii-lab .qb{color:transparent}'
              : '.ascii-lab .qb{background:transparent;color:transparent}',
          )
          .join('\n');
        const row = method.bleed ? 0.97 : 1.08;
        const right = `repeating-linear-gradient(to right, ${paper} 0 1px, transparent 1px 1ch)`;
        const down = `repeating-linear-gradient(to bottom, ${paper} 0 1px, transparent 1px ${row}em)`;
        let surface = '';
        if (method.ink) {
          const washUrl = washImage(cols, rows, wash, paper);
          surface = method.gaps
            ? `background-color:${paper};background-image:${right},${down},url(${washUrl});background-size:auto,auto,100% 100%;background-repeat:repeat,repeat,no-repeat;`
            : `background-color:${paper};background-image:url(${washUrl});background-size:100% 100%;background-repeat:no-repeat;`;
        } else if (method.gaps) {
          surface = `background-image:${right.replace(paper, 'rgba(20,30,40,.1)')},${down.replace(paper, 'rgba(20,30,40,.1)')};`;
        }
        const snippet = `<style>
.ascii-lab{display:block;width:max-content;margin:0;background:${paper};white-space:pre;font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-size:${Math.max(6, Math.min(10, 1200 / cols / 0.6)).toFixed(2)}px;line-height:${row};font-weight:${method.bleed ? 700 : 500};${surface}}
${rules}
</style>
<pre class="ascii-lab">${currentHtml}</pre>`;
        let copied = false;
        try {
          await navigator.clipboard.writeText(snippet);
          copied = true;
        } catch {
          const area = document.createElement('textarea');
          area.value = snippet;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          copied = document.execCommand('copy');
          area.remove();
        }
        setStatus(copied ? 'HTML copied. Paste it with the palette CSS.' : 'Could not copy the HTML.');
      }

      downloadButton.addEventListener('click', downloadPng);
      copyButton.addEventListener('click', copyHtml);
      window.addEventListener('pagehide', () => {
        unsubscribe();
        kit.destroy();
        root.destroy();
      });
    </script>

