---
import "../../../styles/fonts.css";
import Quiet from "../../../prototypes/home-round-four/Quiet.astro";
import Index from "../../../prototypes/home-round-four/Index.astro";
import Spread from "../../../prototypes/home-round-four/Spread.astro";
import Stack from "../../../prototypes/home-round-four/Stack.astro";
import Rail from "../../../prototypes/home-round-four/Rail.astro";

const profile = {
  headline: "Good work. Room for life.",
  paragraph: "I’m Kai Wern Choong, a senior software engineer at Ditto. I want to do thoughtful work and keep time for a life beyond it.",
  points: [
    { text: "Systems programming at Recurse Center" },
    { text: "Small tools built to learn how systems work" },
    { text: "Notes and essays", href: "/blogs/" },
  ],
};
