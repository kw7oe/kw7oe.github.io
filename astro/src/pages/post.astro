---
import { codeToHast, hastToHtml } from "shiki";
import {
  ArticleCallout,
  ArticleCodeBlock,
  ArticleFigure,
  ArticleQuote,
  ArticleTable,
} from "../components/article/ArticleBlocks";
import PrototypePageNav from "../components/PrototypePageNav.astro";
import "../styles/fonts.css";
import "../styles/tailwind.css";
import lmStudioSearch from "../../../assets/images/lmstudio-model-search.png";

const ollamaCode = `# Replace “opencode” with “claude” or “codex” as needed
ollama launch opencode --model qwen3.5:27b
ollama launch opencode --model qwen3.5:35b`;

const articleCodeTheme = {
  name: "article",
  type: "dark",
  colors: {
    "editor.background": "#292735",
    "editor.foreground": "#f2eee9",
  },
  tokenColors: [
    { scope: ["comment"], settings: { foreground: "#b5a9c0", fontStyle: "italic" } },
    { scope: ["keyword", "storage"], settings: { foreground: "#dca18d" } },
    { scope: ["string"], settings: { foreground: "#d8c28f" } },
    { scope: ["entity.name.function", "support.function"], settings: { foreground: "#a7c7b7" } },
    { scope: ["entity.name.type", "support.type", "entity.name.class"], settings: { foreground: "#c5a4d8" } },
    { scope: ["constant.numeric", "constant.language"], settings: { foreground: "#edb67f" } },
  ],
};

const codeThemePresets = [
  {
    value: "article",
    label: "Article",
    shikiKey: "dark",
    shikiTheme: articleCodeTheme,
    background: "#292735",
    foreground: "#f2eee9",
    border: "rgb(255 255 255 / 8%)",
  },
  {
    value: "github-dark",
    label: "GitHub Dark",
    shikiKey: "github-dark",
    shikiTheme: "github-dark",
    background: "#0d1117",
    foreground: "#e6edf3",
    border: "rgb(255 255 255 / 10%)",
  },
  {
    value: "github-light",
    label: "GitHub Light",
    shikiKey: "github-light",
    shikiTheme: "github-light",
    background: "#ffffff",
    foreground: "#1f2328",
    border: "rgb(31 35 40 / 14%)",
  },
  {
    value: "nord",
    label: "Nord",
    shikiKey: "nord",
    shikiTheme: "nord",
    background: "#2e3440",
    foreground: "#d8dee9",
    border: "rgb(216 222 233 / 12%)",
  },
  {
    value: "dracula",
    label: "Dracula",
    shikiKey: "dracula",
    shikiTheme: "dracula",
    background: "#282a36",
    foreground: "#f8f8f2",
    border: "rgb(255 255 255 / 8%)",
  },
  {
    value: "catppuccin-mocha",
    label: "Catppuccin Mocha",
    shikiKey: "catppuccin-mocha",
    shikiTheme: "catppuccin-mocha",
    background: "#1e1e2e",
    foreground: "#cdd6f4",
    border: "rgb(205 214 244 / 12%)",
  },
];

const shikiThemes = Object.fromEntries(codeThemePresets.map(({ shikiKey, shikiTheme }) => [shikiKey, shikiTheme]));
const codeThemeData = codeThemePresets.map(({ value, label, background, foreground, border }) => ({
  value,
  label,
  background,
  foreground,
  border,
}));

const highlightCode = async (code, lang) => {
  const tree = await codeToHast(code, { lang, themes: shikiThemes, defaultColor: "dark" });
  const codeNode = tree.children[0].children[0];
  return hastToHtml({ type: "root", children: codeNode.children });
};

const rustCode = `use pgrx::prelude::*;

pgrx::pg_module_magic!();

#[pg_extern]
fn hello_hello_world() -> &'static str {
    "Hello, hello_world"
}

#[pg_extern]
fn to_title(string: &str) -> String {
    string
        .split(' ')
        .map(|word| {
            word.chars()
                .enumerate()
                .map(|(i, c)| {
                    if i == 0 {
                        c.to_uppercase().to_string()
                    } else {
                        c.to_lowercase().to_string()
                    }
                })
                .collect()
        })
        .collect::<Vec<String>>()
        .join(" ")
}

#[cfg(any(test, feature = "pg_test"))]
#[pg_schema]
mod tests {
    use pgrx::prelude::*;

    #[pg_test]
    fn test_hello_hello_world() {
        assert_eq!("Hello, hello_world", crate::hello_hello_world());
    }

    #[pg_test]
    fn test_to_title() {
        assert_eq!("My Cool Extension", crate::to_title("my cool extension"));
    }
}

#[cfg(test)]
pub mod pg_test {
    pub fn setup(_options: Vec<&str>) {}

    pub fn postgresql_conf_options() -> Vec<&'static str> {
        vec![]
    }
}`;

const elixirCode = `defmodule MiniRedis.Server do
  require Logger

  def accept(port) do
    # The options below mean:
    #
    # 1. :binary receives data as binaries instead of lists.
    # 2. packet: :line receives data one line at a time.
    # 3. active: false blocks on :gen_tcp.recv/2 until data arrives.
    # 4. reuseaddr: true lets the listener reuse its address after a restart.
    {:ok, socket} =
      :gen_tcp.listen(port, [:binary, packet: :line, active: false, reuseaddr: true])

    Logger.info("Accepting connections on port #{port}")
    loop_acceptor(socket)
  end

  defp loop_acceptor(socket) do
    {:ok, client} = :gen_tcp.accept(socket)
    serve(client)
    loop_acceptor(socket)
  end

  defp serve(socket) do
    socket
    |> read_line()
    |> write_line(socket)

    serve(socket)
  end

  defp read_line(socket) do
    {:ok, data} = :gen_tcp.recv(socket, 0)
    data
  end

  defp write_line(line, socket) do
    :gen_tcp.send(socket, line)
  end
end`;

const pythonServerCode = `from http.server import HTTPServer, BaseHTTPRequestHandler
import json

BOOKS = {
    "books": [
        {"name": "The Great Gatsby", "author": "F. Scott Fitzgerald"},
        {"name": "1984", "author": "George Orwell"},
    ]
}

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/books":
            body = json.dumps(BOOKS).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        else:
            self.send_response(404)
            self.end_headers()

if __name__ == "__main__":
    print("Server running at http://localhost:8080/books")
    HTTPServer(("localhost", 8080), Handler).serve_forever()`;

const tcpdumpCode = `sudo tcpdump -i any port 8080
sudo tcpdump -i any port 8080 -w output.pcap`;

const tsharkCode = `# Read a capture
tshark -r output.pcap

# Show only HTTP packets
tshark -r output.pcap -Y 'http'

# Select request and response fields
tshark -r output.pcap -Y 'http' -T fields -e tcp.stream -e frame.time -e http.request.method -e http.request.uri -e http.response.code`;

const [ollamaCodeHtml, rustCodeHtml, elixirCodeHtml, pythonServerCodeHtml, tcpdumpCodeHtml, tsharkCodeHtml] = await Promise.all([
  highlightCode(ollamaCode, "bash"),
  highlightCode(rustCode, "rust"),
  highlightCode(elixirCode, "elixir"),
  highlightCode(pythonServerCode, "python"),
  highlightCode(tcpdumpCode, "bash"),
  highlightCode(tsharkCode, "bash"),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ebe5df" />
    <meta name="description" content="A typography prototype for a local Qwen3.5 guide." />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <title>Run Qwen3.5 locally on your Mac · Kai Wern</title>
  </head>
  <body>
    <a class="skip-link" href="#article">Skip to article</a>
    <main class="page-shell">
      <article class="article" id="article" data-code-themes={JSON.stringify(codeThemeData)}>
        <header class="article-header">
          <p class="eyebrow">Field notes <span aria-hidden="true">/</span> Local AI</p>
          <h1>Run Qwen3.5 locally on your Mac</h1>
          <p class="dek">A short guide to choosing a model and running it on Apple Silicon.</p>
          <div class="metadata">
            <time datetime="2026-03-01">March 1, 2026</time>
            <span>Updated April 18, 2026</span>
            <span class="tag">Qwen3.5</span>
          </div>
        </header>

        <div class="article-body">
          <p>Recently, Qwen3.5 has been one of the hottest models in the community. It’s a vision-language model that’s relatively small and performs well in coding benchmarks. That means I can host it locally on my M-series Mac and use it with <code>opencode</code>.</p>
          <p>I didn’t find many resources online about setting it up, so here’s a short guide.</p>

          <ArticleCallout
            labelId="prerequisite-title"
            label="Prerequisite"
            body="Qwen3.5 now includes 0.8B, 2B, 4B, and 9B models, so you can run it on any M-series Mac. The 4B model needs about 3.4 GB of RAM; 9B needs about 6.6 GB. For the larger models, 27B needs 17 GB, which is tight on a 24 GB machine."
          />

          <h2>Choosing a model</h2>
          <p>Qwen3.5 comes in different architectures, parameter sizes, and quantization levels. The 27B model is dense; the 35B model is a mixture-of-experts model. The latter runs faster, while parameter count and quantization affect memory use.</p>

          <ArticleQuote
            parts={[
              { kind: "text", text: "I suggest starting with LM Studio or " },
              { kind: "code", text: "ollama" },
              { kind: "text", text: ", then exploring " },
              { kind: "code", text: "mlx" },
              { kind: "text", text: " later as needed." },
            ]}
          />

          <ArticleFigure
            src={lmStudioSearch.src}
            width={lmStudioSearch.width}
            height={lmStudioSearch.height}
            alt="LM Studio’s model search results filtered to Qwen3.5 models for MLX."
            caption="Search for Qwen3.5 and filter the model catalog to MLX."
          />

          <h3>Architecture at a glance</h3>
          <ArticleTable
            ariaLabel="Qwen3.5 model comparison"
            caption="A comparison of two Qwen3.5 model tags and their architectures."
            columns={["Model tag", "Architecture", "Parameters"]}
            rows={[
              {
                heading: { kind: "code", text: "qwen3.5:27b" },
                cells: [
                  { kind: "text", text: "Dense" },
                  { kind: "text", text: "27B" },
                ],
              },
              {
                heading: { kind: "code", text: "qwen3.5:35b" },
                cells: [
                  { kind: "text", text: "MoE" },
                  { kind: "text", text: "≈ 36B" },
                ],
              },
            ]}
          />
          <p class="table-note">The summary table restates the model details from the guide.</p>

          <h2>Run it with Ollama</h2>
          <p>To connect a model to <code>opencode</code>, run the matching launch command:</p>
          <ArticleCodeBlock
            ariaLabel="Ollama commands for launching Qwen3.5 with opencode"
            language="bash"
            highlightedHtml={ollamaCodeHtml}
          />

          <h2>Code samples</h2>
          <p>These excerpts from existing Rust and Elixir posts make it easier to compare longer code blocks.</p>

          <h3>Rust · PostgreSQL extension</h3>
          <ArticleCodeBlock
            ariaLabel="Rust PostgreSQL extension example"
            language="rust"
            highlightedHtml={rustCodeHtml}
          />

          <h3>Elixir · Mini Redis TCP server</h3>
          <ArticleCodeBlock
            ariaLabel="Elixir TCP server example"
            language="elixir"
            highlightedHtml={elixirCodeHtml}
          />
        </div>
      </article>
    </main>

    <template id="long-form-content">
      <header class="article-header">
        <p class="eyebrow">Field guide <span aria-hidden="true">/</span> Debugging</p>
        <h1>Debugging HTTP traffic with tcpdump and tshark</h1>
        <p class="dek">Capture HTTP traffic, inspect packet data, and find the useful details in a PCAP file.</p>
        <div class="metadata">
          <time datetime="2026-03-22">March 22, 2026</time>
          <span class="tag">tcpdump</span>
          <span class="tag">tshark</span>
        </div>
      </header>
      <div class="article-body">
        <p>There are times when you need to debug an issue in your HTTP service and realize that your logs don't have enough information. One way to troubleshoot is to capture network traffic and peek into request and response data.</p>
        <p>Sounds hard? It isn't. You can do that with <code>tcpdump</code>, then analyze it with Wireshark or its command-line tool, <code>tshark</code>.</p>
        <p>Here's a quick write-up on capturing HTTP traffic with <code>tcpdump</code> and filtering it with <code>tshark</code>. You can jump to the <a href="#cheat-sheet">cheat sheet</a> for a summary.</p>

        <ArticleQuote
          parts={[
            {
              kind: "text",
              text: "If your services use HTTPS, the packets are encrypted and won't be readable without credentials.",
            },
          ]}
        />

        <h2>Prerequisites</h2>
        <p>If you want to follow along, here are the tools we need:</p>
        <ul>
          <li><code>tcpdump</code></li>
          <li><code>tshark</code></li>
          <li><code>jq</code></li>
          <li><code>python3</code> or anything that can spin up a web server</li>
        </ul>
        <p>Here's a minimal Python server with a JSON endpoint, which we can use to generate a response:</p>
        <ArticleCodeBlock
          ariaLabel="Python HTTP server example"
          language="python"
          highlightedHtml={pythonServerCodeHtml}
        />
        <p>Save this as <code>server.py</code>, then run it with <code>python3 server.py</code>. Use <code>curl localhost:8080/books</code> to generate a JSON response.</p>

        <h2>Capturing traffic</h2>
        <ArticleCallout
          labelId="capture-warning"
          label="Disclaimer"
          body="Captured traffic can contain credentials, cookies, and personal information. Get approval before capturing traffic in a production environment."
        />
        <p>Capturing traffic with <code>tcpdump</code> is straightforward. Add <code>-w</code> to save it to a file for later analysis:</p>
        <ArticleCodeBlock
          ariaLabel="Commands for capturing HTTP traffic"
          language="bash"
          highlightedHtml={tcpdumpCodeHtml}
        />
        <p>Use <code>curl localhost:8080/books</code> to generate a request. Press <kbd>Ctrl</kbd>+<kbd>C</kbd> to stop the capture and see its summary.</p>

        <h2>Filtering and formatting</h2>
        <p>After installing <code>tshark</code>, use it to inspect a capture, filter for HTTP packets, or print selected fields:</p>
        <ArticleCodeBlock
          ariaLabel="Commands for inspecting a PCAP file"
          language="bash"
          highlightedHtml={tsharkCodeHtml}
        />

        <h2 id="cheat-sheet">Cheat sheet</h2>
        <p>Here are a few of the commands covered in the article:</p>
        <ArticleTable
          ariaLabel="HTTP traffic debugging commands"
          caption="Common commands for capturing and reading HTTP traffic."
          columns={["Goal", "Command"]}
          rows={[
            {
              heading: { kind: "text", text: "Capture traffic" },
              cells: [{ kind: "code", text: "sudo tcpdump -i any port 8080" }],
            },
            {
              heading: { kind: "text", text: "Save a capture" },
              cells: [{ kind: "code", text: "sudo tcpdump -i any port 8080 -w output.pcap" }],
            },
            {
              heading: { kind: "text", text: "Generate a request" },
              cells: [{ kind: "code", text: "curl localhost:8080/books" }],
            },
            {
              heading: { kind: "text", text: "Read a capture" },
              cells: [{ kind: "code", text: "tshark -r output.pcap" }],
            },
            {
              heading: { kind: "text", text: "Show HTTP packets" },
              cells: [{ kind: "code", text: "tshark -r output.pcap -Y 'http'" }],
            },
          ]}
        />
        <p class="table-note">Adapted from “Debugging HTTP traffic with tcpdump and tshark.”</p>
        <p>These tools can feel intimidating at first, but the basics are approachable once you know where to start.</p>
      </div>
    </template>

    <template id="about-content">
      <header class="article-header">
        <h1>About me</h1>
        <p class="dek">Just a software engineer.</p>
      </header>
      <div class="article-body">
        <p>Hi, I am Kai, a Senior Software Engineer at Ditto.</p>
      </div>
    </template>

    <PrototypePageNav current="article" />

    <script>
      import { createDialKit, createDialRoot } from "dialkit/vanilla";
      import "dialkit/vanilla/styles.css";
      import { enableDialKitFontGroups, fontFamilies, fontFamilyOptions } from "../lib/font-families.js";

      if (import.meta.env.DEV) {
        const isCompact = window.matchMedia("(max-width: 1249px)").matches;
        createDialRoot({ position: isCompact ? "top-left" : "bottom-right", theme: "light", defaultOpen: !isCompact });

        const article = document.getElementById("article");
        const codeThemePresets = JSON.parse(article.dataset.codeThemes);
        const basicTemplate = document.createElement("template");
        basicTemplate.content.append(...Array.from(article.childNodes, (node) => node.cloneNode(true)));
        const contentTemplates = new Map([
          ["basic", basicTemplate],
          ["http-debugging", document.querySelector("#long-form-content")],
          ["about", document.querySelector("#about-content")],
        ]);
        let currentContent = "basic";

        const renderContent = (preset) => {
          const template = contentTemplates.get(preset);
          if (!template || currentContent === preset) return;

          article.replaceChildren(template.content.cloneNode(true));
          currentContent = preset;
          const title = article.querySelector("h1").textContent.trim();
          const description = article.querySelector(".dek")?.textContent.trim() ?? title;
          document.title = `${title} · Kai Wern`;
          document.querySelector('meta[name="description"]').setAttribute("content", description);
          window.scrollTo(0, 0);
        };

        const family = (defaultFamily) => ({
          type: "select",
          options: fontFamilyOptions,
          default: defaultFamily,
        });
        const articleStyle = createDialKit("Article style", {
          content: {
            preset: {
              type: "select",
              options: [
                { value: "basic", label: "Basic · Qwen3.5" },
                { value: "http-debugging", label: "Long-form · HTTP traffic" },
                { value: "about", label: "About me" },
              ],
              default: "http-debugging",
            },
          },
          title: {
            family: family("Instrument Serif"),
            size: [48, 40, 96, 1],
          },
          body: {
            _collapsed: false,
            family: family("Instrument Sans"),
            size: [16, 15, 24, 1],
            lineHeight: [1.4, 1.4, 2, 0.05],
            paragraphGap: [8, 8, 48, 1],
          },
          headings: {
            _collapsed: true,
            family: family("Instrument Serif"),
            h2Size: [36, 24, 56, 1],
            h3Size: [22, 16, 34, 1],
            sectionGap: [35, 20, 72, 1],
            bodyGap: [12, 0, 32, 1],
          },
          callout: {
            _collapsed: true,
            style: {
              type: "select",
              options: [
                { value: "rail", label: "Classic rail" },
                { value: "panel", label: "Signal card" },
                { value: "outlined", label: "Open frame" },
                { value: "split", label: "Margin note" },
              ],
              default: "rail",
            },
            family: family("Instrument Sans"),
            size: [16, 14, 24, 1],
            lineHeight: [1.4, 1.35, 1.9, 0.05],
            paddingX: [22, 12, 40, 1],
            paddingY: [20, 12, 36, 1],
            labelGap: [12, 0, 20, 1],
          },
          spacing: {
            _collapsed: true,
            componentGap: [24, 8, 64, 1],
          },
          code: {
            _collapsed: true,
            theme: {
              type: "select",
              options: codeThemePresets.map(({ value, label }) => ({ value, label })),
              default: "catppuccin-mocha",
            },
            family: family("IBM Plex Mono"),
            size: [14, 12, 20, 1],
            lineHeight: [1.5, 1.2, 2, 0.05],
            padding: [12, 12, 32, 1],
          },
          inlineCode: {
            _collapsed: true,
            family: family("IBM Plex Mono"),
            scale: [95, 60, 110, 1],
            paddingX: [4, 0, 10, 1],
            paddingY: [2, 0, 6, 1],
            radius: [4, 0, 10, 1],
            background: { type: "color", default: "#ddd7d0" },
            color: { type: "color", default: "#403c45" },
          },
          table: {
            _collapsed: true,
            family: family("Instrument Sans"),
            size: [15, 12, 20, 1],
            cellPadding: [12, 6, 24, 1],
          },
          quote: {
            _collapsed: true,
            style: {
              type: "select",
              options: [
                { value: "rail", label: "Classic rail" },
                { value: "panel", label: "Soft panel" },
                { value: "centered", label: "Centered display" },
                { value: "framed", label: "Framed quote" },
              ],
              default: "rail",
            },
            family: family("Instrument Sans"),
            size: [20, 18, 40, 1],
            inset: [25, 0, 48, 1],
          },
          caption: {
            _collapsed: true,
            family: family("Instrument Sans"),
            size: [13, 12, 18, 1],
            gap: [12, 4, 24, 1],
          },
        });

        articleStyle.subscribe(({ content, title, body, headings, callout, spacing, code, inlineCode, table, quote, caption }) => {
          renderContent(content.preset);
          const selectedCodeTheme = codeThemePresets.find(({ value }) => value === code.theme);
          const root = document.documentElement.style;
          root.setProperty("--title-font", fontFamilies[title.family].stack);
          root.setProperty("--title-size", `${title.size}px`);
          root.setProperty("--body-font", fontFamilies[body.family].stack);
          root.setProperty("--body-size", `${body.size}px`);
          root.setProperty("--body-line-height", body.lineHeight);
          root.setProperty("--paragraph-gap", `${body.paragraphGap}px`);
          root.setProperty("--heading-font", fontFamilies[headings.family].stack);
          root.setProperty("--h2-size", `${headings.h2Size}px`);
          root.setProperty("--h3-size", `${headings.h3Size}px`);
          root.setProperty("--section-gap", `${headings.sectionGap}px`);
          root.setProperty("--heading-body-gap", `${headings.bodyGap}px`);
          root.setProperty("--callout-font", fontFamilies[callout.family].stack);
          root.setProperty("--callout-size", `${callout.size}px`);
          root.setProperty("--callout-line-height", callout.lineHeight);
          root.setProperty("--callout-padding-x", `${callout.paddingX}px`);
          root.setProperty("--callout-padding-y", `${callout.paddingY}px`);
          root.setProperty("--callout-label-gap", `${callout.labelGap}px`);
          document.documentElement.dataset.calloutStyle = callout.style;
          root.setProperty("--component-gap", `${spacing.componentGap}px`);
          root.setProperty("--code-font", fontFamilies[code.family].stack);
          root.setProperty("--code-size", `${code.size}px`);
          root.setProperty("--code-line-height", code.lineHeight);
          root.setProperty("--code-padding", `${code.padding}px`);
          root.setProperty("--code-background", selectedCodeTheme.background);
          root.setProperty("--code-foreground", selectedCodeTheme.foreground);
          root.setProperty("--code-border", selectedCodeTheme.border);
          document.documentElement.dataset.codeTheme = code.theme;
          root.setProperty("--inline-code-font", fontFamilies[inlineCode.family].stack);
          root.setProperty("--inline-code-scale", `${inlineCode.scale}%`);
          root.setProperty("--inline-code-padding-x", `${inlineCode.paddingX}px`);
          root.setProperty("--inline-code-padding-y", `${inlineCode.paddingY}px`);
          root.setProperty("--inline-code-radius", `${inlineCode.radius}px`);
          root.setProperty("--inline-code-background", inlineCode.background);
          root.setProperty("--inline-code-color", inlineCode.color);
          root.setProperty("--table-font", fontFamilies[table.family].stack);
          root.setProperty("--table-size", `${table.size}px`);
          root.setProperty("--table-cell-padding", `${table.cellPadding}px`);
          root.setProperty("--quote-font", fontFamilies[quote.family].stack);
