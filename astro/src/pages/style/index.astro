---
import { HomeIdentity } from "../../components/home/HomeIdentity";
import PrototypePageNav from "../../components/PrototypePageNav.astro";
import "../../styles/tailwind.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ebe5df" />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
    <title>Kai Wern</title>
  </head>
  <body>
    <main class="grid w-full gap-[var(--text-gap)] px-4 [overflow-wrap:break-word] [text-align:var(--text-alignment)]">
      <HomeIdentity title="Kai Wern" description="Just a software engineer" />
    </main>
    <PrototypePageNav current="homepage" />
  </body>
</html>

<script>
  import { createDialKit, createDialRoot } from "dialkit/vanilla";
  import "dialkit/vanilla/styles.css";
  import { enableDialKitFontGroups, fontFamilies, fontFamilyOptions } from "../../lib/font-families.js";

  if (import.meta.env.DEV) {
    const isCompact = window.matchMedia("(max-width: 850px)").matches;
    createDialRoot({ position: "top-left", theme: "light", defaultOpen: !isCompact });

    const titleSize = Math.round(Math.min(104, Math.max(56, window.innerWidth * 0.09)));
    const marginLeftLimit = Math.round(window.innerWidth / 2);
    const marginTopLimit = Math.round(window.innerHeight / 2);
    const typography = createDialKit("Typography", {
      title: {
        _collapsed: isCompact,
        text: { type: "text", default: "Kai Wern", placeholder: "Title" },
        family: {
          type: "select",
          options: fontFamilyOptions,
          default: "Instrument Serif",
        },
        size: [titleSize, 24, 144, 1],
        margin: {
          _collapsed: true,
          top: [0, -marginTopLimit, marginTopLimit, 1],
          left: [0, -marginLeftLimit, marginLeftLimit, 1],
        },
      },
      description: {
        _collapsed: isCompact,
        text: { type: "text", default: "Just a software engineer", placeholder: "Description" },
        family: {
          type: "select",
          options: fontFamilyOptions,
          default: "Instrument Sans",
        },
        size: [16, 10, 40, 1],
        margin: {
          _collapsed: true,
          top: [0, -marginTopLimit, marginTopLimit, 1],
          left: [0, -marginLeftLimit, marginLeftLimit, 1],
        },
      },
      layout: {
        _collapsed: isCompact,
        gap: [12, 0, 64, 1],
        alignment: {
          type: "select",
          options: [
            { value: "left", label: "Left" },
            { value: "center", label: "Center" },
            { value: "right", label: "Right" },
          ],
          default: "center",
        },
      },
    });

    typography.subscribe(({ title, description, layout }) => {
      const root = document.documentElement.style;
      document.getElementById("title").textContent = title.text;
      document.getElementById("description").textContent = description.text;
      document.title = title.text;
      root.setProperty("--title-font", fontFamilies[title.family].stack);
      root.setProperty("--title-size", `${title.size}px`);
      root.setProperty("--title-margin-top", `${title.margin.top}px`);
      root.setProperty("--title-margin-left", `${title.margin.left}px`);
      root.setProperty("--description-font", fontFamilies[description.family].stack);
      root.setProperty("--description-size", `${description.size}px`);
      root.setProperty("--description-margin-top", `${description.margin.top}px`);
      root.setProperty("--description-margin-left", `${description.margin.left}px`);
      root.setProperty("--text-gap", `${layout.gap}px`);
      root.setProperty("--text-alignment", layout.alignment);
    });

    enableDialKitFontGroups();
  }
</script>

