    --title-margin-top: 0px;
    --title-margin-left: 0px;
    --description-font: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    --description-size: 1rem;
    --description-margin-top: 0px;
    --description-margin-left: 0px;
    --text-gap: 0.75rem;
    --text-alignment: center;
  }

  :global(body) {
    display: grid;
    min-height: 100vh;
    place-items: center;
    margin: 0;
    background: #ebe5df;
    color: #292735;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  @media (max-width: 540px) {
