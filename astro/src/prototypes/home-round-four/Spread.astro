---
interface Props {
  headline: string;
  paragraph: string;
  points: { text: string; href?: string }[];
}

const { headline, paragraph, points } = Astro.props;
---

<article class="spread" aria-labelledby="spread-heading">
  <h1 id="spread-heading">{headline}</h1>
  <p>{paragraph}</p>
  <ul>
    {points.map((point) => (
      <li>{point.href ? <a href={point.href}>{point.text}</a> : point.text}</li>
    ))}
  </ul>
</article>

<style>
  .spread {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.72fr);
    column-gap: clamp(48px, 9vw, 128px);
    row-gap: clamp(34px, 7vh, 68px);
    align-content: center;
    width: min(100%, 1120px);
    min-height: 100svh;
    margin-inline: auto;
    padding: clamp(72px, 12vh, 136px) clamp(28px, 8vw, 112px) 112px;
  }

  h1 {
    grid-column: 1 / -1;
    max-width: 18ch;
    margin: 0;
    font-family: var(--display-font);
    font-size: clamp(2.1rem, 3.3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-optical-sizing: auto;
    text-wrap: balance;
  }

  p {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
    font-family: var(--body-font);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-block: 0 12px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--body-font);
    font-size: 1rem;
    line-height: 1.45;
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in oklch, var(--accent) 48%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover { text-decoration-color: currentColor; }
  }

  @media (max-width: 680px) {
    .spread {
      grid-template-columns: 1fr;
      row-gap: 24px;
      padding-inline: 28px;
    }

    h1 { margin-bottom: 8px; }
  }
</style>
