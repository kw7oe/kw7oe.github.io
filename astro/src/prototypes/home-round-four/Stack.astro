---
interface Props {
  headline: string;
  paragraph: string;
  points: { text: string; href?: string }[];
}

const { headline, paragraph, points } = Astro.props;
---

<article class="stack" aria-labelledby="stack-heading">
  <div class="stack__copy">
    <h1 id="stack-heading">{headline}</h1>
    <p>{paragraph}</p>
    <ul>
      {points.map((point) => (
        <li>{point.href ? <a href={point.href}>{point.text}</a> : point.text}</li>
      ))}
    </ul>
  </div>
</article>

<style>
  .stack {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: clamp(72px, 12vh, 136px) 28px 112px;
    text-align: center;
  }

  .stack__copy { width: min(100%, 600px); }

  h1 {
    max-width: 15ch;
    margin: 0 auto;
    font-family: var(--display-font);
    font-size: clamp(2.05rem, 3.3vw, 2.55rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.035em;
    font-optical-sizing: auto;
    text-wrap: balance;
  }

  p {
    max-width: 47ch;
    margin: 22px auto 0;
    color: var(--muted);
    font-family: var(--body-font);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  ul {
    display: grid;
    width: fit-content;
    max-width: 100%;
    gap: 10px;
    margin: 30px auto 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    width: 100%;
    padding-inline-start: 14px;
    color: var(--muted);
    font-family: var(--body-font);
    font-size: 1rem;
    line-height: 1.5;
    text-align: start;
  }

  li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    content: "";
  }

  a {
    color: var(--ink);
    text-decoration-color: color-mix(in oklch, var(--accent) 48%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover { text-decoration-color: currentColor; }
  }

</style>
