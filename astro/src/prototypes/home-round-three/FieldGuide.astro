---
const { navigation, projects } = Astro.props;
---

<article class="field-guide" aria-labelledby="field-guide-title">
  <header class="field-guide__header">
    <a href="/" aria-label="Kai Wern Choong home">FIELD / KWC</a>
    <nav aria-label="Site navigation">
      {navigation.map((item) => <a href={item.href}>{item.title}</a>)}
    </nav>
    <span>COLLECTION 04 / ACTIVE</span>
  </header>

  <div class="field-guide__folio">
    <aside class="field-guide__profile">
      <p class="field-guide__folio-number">FIELD NOTE <span>04</span></p>
      <p class="field-guide__classification">A WORKING-LIFE RECORD</p>
      <h1 id="field-guide-title">A life among<br /><em>good questions.</em></h1>
      <p class="field-guide__intro">I’m Kai, a senior software engineer at <a href="https://www.ditto.live" target="_blank" rel="noreferrer">Ditto</a>. I’m trying to keep a good work-life balance, with room for small things made to learn.</p>
      <dl class="field-guide__facts">
        <div><dt>Occupation</dt><dd>Software engineering</dd></div>
        <div><dt>Current place</dt><dd>Ditto</dd></div>
        <div><dt>Study ground</dt><dd>Recurse Center</dd></div>
        <div><dt>Subject</dt><dd>System programming</dd></div>
      </dl>
      <p class="field-guide__margin-note">Collected over time<br />not all at once.</p>
    </aside>

    <section class="field-guide__record" aria-labelledby="field-guide-projects">
      <div class="field-guide__record-heading">
        <span class="field-guide__vertical-index" aria-hidden="true">OBSERVATIONS / 01—05</span>
        <div>
          <p>WORKS &amp; EXPERIMENTS</p>
          <h2 id="field-guide-projects">Things built<br />to learn.</h2>
        </div>
        <p class="field-guide__record-note">Small systems<br />from the ground up</p>
      </div>
      <ol>
        {projects.map((project, index) => (
          <li>
            <span class="field-guide__observation">OBS. 0{index + 1}</span>
            <div>
              <h3><a href={project.href} target="_blank" rel="noreferrer">{project.title}</a></h3>
              <p>{project.description}</p>
            </div>
            <span class="field-guide__specimen-label">{project.group === "systems" ? "SYSTEMS / STUDY" : "EARLIER / TOOL"}</span>
          </li>
        ))}
      </ol>
      <footer><span>END OF RECORD</span><a href="/blogs/">Field notes &amp; essays <span aria-hidden="true">↗</span></a></footer>
    </section>
  </div>
</article>

<style>
  .field-guide { max-width: 1360px; min-height: 100svh; margin-inline: auto; padding: 28px clamp(28px, 7.5vw, 104px) 150px; font-family: var(--body-font); }
  .field-guide a { color: inherit; text-decoration-color: color-mix(in oklab, currentColor 38%, transparent); text-underline-offset: 0.18em; }
  .field-guide__header { display: flex; align-items: center; gap: 25px; padding-bottom: 14px; border-bottom: 1px solid var(--ink); font-size: 10px; letter-spacing: 0.11em; text-transform: uppercase; }
  .field-guide__header > a { color: var(--accent); text-decoration: none; white-space: nowrap; }
  .field-guide__header nav { display: flex; flex-wrap: wrap; gap: 12px; }
  .field-guide__header nav a { text-decoration: none; }
  .field-guide__header > span { margin-left: auto; color: var(--muted); white-space: nowrap; }
  .field-guide__folio { display: grid; grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr); gap: clamp(50px, 9vw, 128px); padding-top: clamp(48px, 7vw, 92px); }
  .field-guide__profile { position: relative; align-self: start; padding-right: clamp(20px, 3vw, 42px); border-right: 1px solid var(--rule); }
  .field-guide__folio-number, .field-guide__classification, .field-guide__record-heading > div > p, .field-guide__observation, .field-guide__specimen-label, .field-guide__record footer, .field-guide__vertical-index { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; }
  .field-guide__folio-number { display: flex; justify-content: space-between; margin: 0; padding-bottom: 11px; border-bottom: 1px solid var(--ink); color: var(--muted); }
  .field-guide__folio-number span { color: var(--accent); }
  .field-guide__classification { margin: 24px 0 17px; color: var(--accent); }
  .field-guide__profile h1 { margin: 0; font: 400 clamp(2.7rem, 4.8vw, 4.5rem)/0.98 var(--display-font); letter-spacing: -0.04em; text-wrap: balance; }
  .field-guide__profile h1 em { color: var(--accent); font-weight: 400; }
  .field-guide__intro { max-width: 390px; margin: 25px 0 28px; font-size: 15px; line-height: 1.65; }
  .field-guide__facts { margin: 0; border-top: 1px solid var(--rule); }
  .field-guide__facts div { display: grid; grid-template-columns: minmax(100px, 0.8fr) 1.2fr; gap: 12px; padding-block: 9px; border-bottom: 1px solid var(--rule); }
  .field-guide__facts dt { color: var(--muted); font-size: 11px; }
  .field-guide__facts dd { margin: 0; font: 400 16px/1.2 var(--display-font); }
  .field-guide__margin-note { margin: 27px 0 0; color: var(--muted); font: italic 14px/1.35 var(--display-font); }
  .field-guide__record { min-width: 0; }
  .field-guide__record-heading { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 16px; align-items: end; padding-bottom: 23px; border-bottom: 1px solid var(--ink); }
  .field-guide__vertical-index { writing-mode: vertical-rl; transform: rotate(180deg); color: var(--muted); }
  .field-guide__record-heading > div > p { margin: 0 0 13px; color: var(--accent); }
  .field-guide__record-heading h2 { margin: 0; font: 400 clamp(2.3rem, 4vw, 4rem)/0.98 var(--display-font); letter-spacing: -0.045em; text-wrap: balance; }
  .field-guide__record-note { margin: 0 0 4px; color: var(--muted); font: italic 13px/1.35 var(--display-font); text-align: right; }
  .field-guide__record ol { margin: 0; padding: 0; list-style: none; }
  .field-guide__record li { display: grid; grid-template-columns: 76px minmax(0, 1fr) 100px; gap: 15px; align-items: start; padding: 20px 0 18px; border-bottom: 1px solid var(--rule); }
  .field-guide__observation, .field-guide__specimen-label { padding-top: 6px; color: var(--muted); font-size: 9px; }
  .field-guide__observation { color: var(--accent); }
  .field-guide__record li h3 { margin: 0; font: 400 clamp(1.2rem, 1.8vw, 1.6rem)/1.14 var(--display-font); }
  .field-guide__record li h3 a { text-decoration: none; }
  .field-guide__record li p { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .field-guide__specimen-label { text-align: right; }
  .field-guide__record footer { display: flex; justify-content: space-between; gap: 20px; margin-top: 26px; padding-top: 11px; border-top: 1px solid var(--ink); }
  .field-guide__record footer a { text-decoration: none; }
  .field-guide__record footer a span { color: var(--accent); }
  @media (max-width: 850px) {
    .field-guide__folio { grid-template-columns: 1fr; gap: 60px; }
    .field-guide__profile { padding: 0; border: 0; }
    .field-guide__profile h1 { font-size: clamp(3.1rem, 10vw, 4.8rem); }
    .field-guide__facts { max-width: 560px; }
  }
  @media (max-width: 560px) {
    .field-guide__header { flex-wrap: wrap; gap: 12px; }
    .field-guide__header > span { margin-left: 0; }
    .field-guide__record-heading { grid-template-columns: 18px 1fr; }
    .field-guide__vertical-index { font-size: 8px; }
    .field-guide__record-note { grid-column: 2; text-align: left; }
    .field-guide__record li { grid-template-columns: 56px minmax(0, 1fr); gap: 8px 12px; }
    .field-guide__specimen-label { grid-column: 2; text-align: left; }
    .field-guide__record footer { flex-direction: column; gap: 8px; }
  }
</style>
