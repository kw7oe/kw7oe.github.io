---
const { navigation, projects } = Astro.props;
---

<article class="gatefold-notes" aria-labelledby="gatefold-title">
  <header class="gatefold-notes__header">
    <a href="/" aria-label="Kai Wern Choong home">KAI WERN CHOONG</a>
    <nav aria-label="Site navigation">
      {navigation.map((item) => <a href={item.href}>{item.title}</a>)}
    </nav>
    <span>FOLD-OUT / 05</span>
  </header>

  <div class="gatefold-notes__sleeve-label"><span>PERSONAL LINER NOTES</span><span>PLAY BOTH SIDES</span></div>

  <div class="gatefold-notes__spread">
    <section class="gatefold-notes__side gatefold-notes__side--a" aria-labelledby="gatefold-title">
      <p class="gatefold-notes__side-number">SIDE A <span>01—03</span></p>
      <h1 id="gatefold-title">The work<br />and the life<br /><em>around it.</em></h1>
      <p class="gatefold-notes__lead">I’m Kai, a senior software engineer at <a href="https://www.ditto.live" target="_blank" rel="noreferrer">Ditto</a>. Good work matters. So does having time for the rest of life.</p>
      <div class="gatefold-notes__credits">
        <div><span>NOW</span><p>Building software at Ditto</p></div>
        <div><span>IN PRACTICE</span><p>Keeping work-life balance in view</p></div>
        <div><span>STUDY</span><p>System programming at Recurse Center</p></div>
      </div>
      <p class="gatefold-notes__liner-note">A collection of small projects, made to learn how the pieces fit together.</p>
    </section>

    <section class="gatefold-notes__side gatefold-notes__side--b" aria-labelledby="gatefold-projects">
      <div class="gatefold-notes__track-heading">
        <div><p class="gatefold-notes__side-number">SIDE B <span>01—05</span></p><h2 id="gatefold-projects">Project notes</h2></div>
        <span class="gatefold-notes__disc" aria-hidden="true"><span>KWC</span></span>
      </div>
      <ol>
        {projects.map((project, index) => (
          <li>
            <span class="gatefold-notes__track-number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3><a href={project.href} target="_blank" rel="noreferrer">{project.title}</a></h3>
              <p>{project.description}</p>
            </div>
            <span class="gatefold-notes__track-time">{project.group === "systems" ? "RC" : "ARCHIVE"}</span>
          </li>
        ))}
      </ol>
      <footer><span>COMPILED BY KAI</span><a href="/blogs/">Read more <span aria-hidden="true">↗</span></a></footer>
    </section>
  </div>

  <footer class="gatefold-notes__bottom"><span>PERSONAL EDITION / OPENED FLAT</span><span>NO. 05 — HOME</span></footer>
</article>

<style>
  .gatefold-notes { max-width: 1360px; min-height: 100svh; margin-inline: auto; padding: 28px clamp(28px, 7.5vw, 104px) 148px; font-family: var(--body-font); }
  .gatefold-notes a { color: inherit; text-decoration-color: color-mix(in oklab, currentColor 38%, transparent); text-underline-offset: 0.18em; }
  .gatefold-notes__header { display: flex; align-items: center; gap: 28px; padding-bottom: 14px; border-bottom: 1px solid var(--ink); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; }
  .gatefold-notes__header > a { text-decoration: none; }
  .gatefold-notes__header nav { display: flex; flex-wrap: wrap; gap: 12px; }
  .gatefold-notes__header nav a { text-decoration: none; }
  .gatefold-notes__header > span { margin-left: auto; color: var(--muted); }
  .gatefold-notes__sleeve-label { display: flex; justify-content: space-between; margin-top: 20px; padding-bottom: 9px; border-bottom: 1px solid var(--rule); color: var(--muted); font-size: 9px; letter-spacing: 0.14em; }
  .gatefold-notes__spread { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); margin-top: 0; border-bottom: 1px solid var(--ink); }
  .gatefold-notes__side { min-width: 0; padding: clamp(32px, 5vw, 70px) clamp(24px, 4vw, 60px) 34px; }
  .gatefold-notes__side--a { padding-left: 0; border-right: 1px solid var(--ink); }
  .gatefold-notes__side--b { padding-right: 0; }
  .gatefold-notes__side-number { display: flex; justify-content: space-between; gap: 18px; margin: 0; color: var(--muted); font-size: 10px; letter-spacing: 0.13em; }
  .gatefold-notes__side-number span { color: var(--accent); }
  .gatefold-notes__side h1 { margin: 33px 0 22px; font: 400 clamp(3rem, 5.4vw, 5.5rem)/0.96 var(--display-font); letter-spacing: -0.045em; text-wrap: balance; }
  .gatefold-notes__side h1 em { color: var(--accent); font-weight: 400; }
  .gatefold-notes__lead { max-width: 470px; margin: 0; font: 400 clamp(1.1rem, 1.5vw, 1.3rem)/1.55 var(--display-font); }
  .gatefold-notes__credits { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; margin-top: 36px; border-top: 1px solid var(--rule); }
  .gatefold-notes__credits div { padding: 13px 0 12px; border-bottom: 1px solid var(--rule); }
  .gatefold-notes__credits div:first-child { grid-column: 1 / -1; }
  .gatefold-notes__credits span, .gatefold-notes__track-time, .gatefold-notes__track-number, .gatefold-notes__side--b footer, .gatefold-notes__bottom { font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; }
  .gatefold-notes__credits span { color: var(--accent); }
  .gatefold-notes__credits p { margin: 7px 0 0; font: 400 16px/1.2 var(--display-font); }
  .gatefold-notes__liner-note { max-width: 360px; margin: 31px 0 0; color: var(--muted); font: italic 15px/1.45 var(--display-font); }
  .gatefold-notes__track-heading { display: flex; justify-content: space-between; align-items: center; gap: 25px; padding-bottom: 27px; border-bottom: 1px solid var(--ink); }
  .gatefold-notes__track-heading h2 { margin: 14px 0 0; font: 400 clamp(2rem, 3.2vw, 3.2rem)/1.02 var(--display-font); letter-spacing: -0.04em; }
  .gatefold-notes__disc { display: grid; place-items: center; width: clamp(74px, 10vw, 126px); aspect-ratio: 1; flex: none; border: 1px solid var(--rule); border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 5px, color-mix(in oklab, var(--rule) 70%, transparent) 5.5px 6px); }
  .gatefold-notes__disc span { display: grid; place-items: center; width: 35%; aspect-ratio: 1; border-radius: 50%; background: var(--accent); color: var(--canvas); font-size: 8px; letter-spacing: 0.06em; }
  .gatefold-notes__side--b ol { margin: 0; padding: 0; list-style: none; }
  .gatefold-notes__side--b li { display: grid; grid-template-columns: 25px minmax(0, 1fr) 54px; gap: 9px; align-items: start; padding: 17px 0 16px; border-bottom: 1px solid var(--rule); }
  .gatefold-notes__track-number { padding-top: 4px; color: var(--accent); }
  .gatefold-notes__side--b li h3 { margin: 0; font: 400 clamp(1.1rem, 1.55vw, 1.35rem)/1.16 var(--display-font); }
  .gatefold-notes__side--b li h3 a { text-decoration: none; }
  .gatefold-notes__side--b li p { margin: 5px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .gatefold-notes__track-time { padding-top: 5px; color: var(--muted); text-align: right; font-size: 8px; }
  .gatefold-notes__side--b footer { display: flex; justify-content: space-between; gap: 15px; margin-top: 23px; }
  .gatefold-notes__side--b footer a { text-decoration: none; }
  .gatefold-notes__side--b footer a span { color: var(--accent); }
  .gatefold-notes__bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 12px; color: var(--muted); }
  @media (max-width: 850px) {
    .gatefold-notes__spread { grid-template-columns: 1fr; }
    .gatefold-notes__side--a { padding: 40px 0; border-right: 0; border-bottom: 1px solid var(--ink); }
    .gatefold-notes__side--b { padding: 40px 0 32px; }
    .gatefold-notes__side h1 { font-size: clamp(3.25rem, 10vw, 5.2rem); }
  }
  @media (max-width: 560px) {
    .gatefold-notes__header { flex-wrap: wrap; gap: 12px; }
    .gatefold-notes__header > span { margin-left: 0; }
    .gatefold-notes__side--b li { grid-template-columns: 22px minmax(0, 1fr); }
    .gatefold-notes__track-time { grid-column: 2; text-align: left; }
    .gatefold-notes__credits { grid-template-columns: 1fr; }
    .gatefold-notes__credits div:first-child { grid-column: auto; }
    .gatefold-notes__bottom { font-size: 8px; }
  }
</style>
