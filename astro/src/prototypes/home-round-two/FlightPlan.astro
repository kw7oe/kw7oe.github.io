---
const { navigation, projects } = Astro.props;
const systemsProjects = projects.filter((project) => project.group === "systems");
const earlierProjects = projects.filter((project) => project.group === "earlier");
---

<section class="flight-plan" aria-labelledby="flight-plan-title">
  <header class="flight-plan__header">
    <a class="flight-plan__wordmark" href="/">KAI WERN CHOONG <span>· PERSONAL FLIGHT PLAN</span></a>
    <nav aria-label="Primary navigation">
      {navigation.map((item) => <a href={item.href} aria-current={item.href === "/" ? "page" : undefined}>{item.title}</a>)}
      <a href="/proto/home/">Round one</a>
    </nav>
  </header>

  <div class="flight-plan__hero">
    <div>
      <p class="flight-plan__eyebrow">Mission status <span>Ongoing</span></p>
      <h1 id="flight-plan-title">Make room for both.</h1>
      <p class="flight-plan__intro">I’m Kai, a senior software engineer at <a href="https://www.ditto.live" target="_blank" rel="noreferrer">Ditto</a>. The work matters. So does having a life after it.</p>
    </div>
    <aside class="flight-plan__status" aria-label="Current status">
      <p>Current assignment</p>
      <strong>Software engineering</strong>
      <span>Ditto · now</span>
      <div class="flight-plan__status-rule" aria-hidden="true"></div>
      <p>Operating principle</p>
      <strong>Keep a good balance</strong>
    </aside>
  </div>

  <section class="flight-plan__log" aria-labelledby="flight-plan-log-title">
    <div class="flight-plan__log-heading">
      <h2 id="flight-plan-log-title">Flight sequence</h2>
      <p>Three phases, one working life</p>
    </div>
    <div class="flight-plan__table-head" aria-hidden="true">
      <span>Phase</span><span>Focus</span><span>Notes from the cabin</span>
    </div>
    <article class="flight-plan__row">
      <span class="flight-plan__phase">01 <small>NOW</small></span>
      <div><h3>Work</h3><p>Senior Software Engineer</p></div>
      <p>Building at <a href="https://www.ditto.live" target="_blank" rel="noreferrer">Ditto</a>, while protecting time away from the keyboard.</p>
    </article>
    <article class="flight-plan__row">
      <span class="flight-plan__phase">02 <small>STUDY</small></span>
      <div><h3>Recurse Center</h3><p>System programming</p></div>
      <ul>
        {systemsProjects.map((project) => <li><a href={project.href} target="_blank" rel="noreferrer">{project.title}</a><span>{project.description}</span></li>)}
      </ul>
    </article>
    <article class="flight-plan__row">
      <span class="flight-plan__phase">03 <small>EARLIER BUILDS</small></span>
      <div><h3>Projects</h3><p>Small tools, made to learn</p></div>
      <ul>
        {earlierProjects.map((project) => <li><a href={project.href} target="_blank" rel="noreferrer">{project.title}</a><span>{project.description}</span></li>)}
      </ul>
    </article>
  </section>

  <footer class="flight-plan__footer">
    <p>Document study: <a href="https://www.archives.gov/exhibits/featured-documents/apollo-11-flight-plan/flight-plan.html" target="_blank" rel="noreferrer">Apollo 11 Flight Plan · U.S. National Archives</a></p>
    <span>HOME · PERSONAL EDITION 02</span>
  </footer>
</section>

<style>
  .flight-plan {
    min-height: 100svh;
    padding: 28px clamp(22px, 5vw, 76px) 104px;
    background: var(--canvas);
    color: var(--ink);
    font-family: var(--body-font);
  }

  .flight-plan__header,
  .flight-plan__header nav,
  .flight-plan__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }

  .flight-plan__header {
    max-width: 1280px;
    margin: 0 auto;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }

  .flight-plan__wordmark,
  .flight-plan__header nav a,
  .flight-plan__footer {
    color: var(--muted);
    font: 500 0.75rem/1.5 var(--body-font);
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .flight-plan__wordmark { color: var(--ink); }
  .flight-plan__wordmark span { color: var(--muted); }
  .flight-plan__header nav { flex-wrap: wrap; justify-content: flex-end; gap: 4px 18px; }
  .flight-plan__header nav a { display: inline-flex; align-items: center; min-height: 44px; letter-spacing: 0.06em; }
  .flight-plan__header nav a[aria-current="page"] { color: var(--accent); }

  .flight-plan__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.55fr);
    align-items: end;
    gap: clamp(44px, 9vw, 140px);
    max-width: 1160px;
    margin: clamp(68px, 10vw, 138px) auto 104px;
  }

  .flight-plan__eyebrow,
  .flight-plan__status p,
  .flight-plan__log-heading p,
  .flight-plan__table-head,
  .flight-plan__phase,
  .flight-plan__phase small {
    color: var(--muted);
    font: 500 0.75rem/1.5 var(--body-font);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .flight-plan__eyebrow { display: flex; align-items: center; gap: 12px; }
  .flight-plan__eyebrow span { color: var(--accent); }
  .flight-plan h1 {
    max-width: 11ch;
    margin: 22px 0 26px;
    font: 400 clamp(3.3rem, 8.5vw, 7.1rem)/0.98 var(--display-font);
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .flight-plan__intro {
    max-width: 56ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .flight-plan a:not(.flight-plan__wordmark) { text-decoration-thickness: from-font; text-underline-offset: 0.16em; }
  .flight-plan__intro a,
  .flight-plan__row a,
  .flight-plan__footer a { color: var(--accent); }

  .flight-plan__status {
    padding: 24px 0 4px;
    border-top: 2px solid var(--accent);
  }

  .flight-plan__status p { margin: 0 0 10px; }
  .flight-plan__status strong { display: block; font: 500 1.2rem/1.35 var(--display-font); }
  .flight-plan__status > span { display: block; margin-top: 5px; color: var(--muted); font-size: 0.9rem; }
  .flight-plan__status-rule { height: 1px; margin: 24px 0; background: var(--rule); }

  .flight-plan__log { max-width: 1160px; margin: 0 auto; }
  .flight-plan__log-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .flight-plan__log-heading h2 { margin: 0; font: 400 1.55rem/1.2 var(--display-font); }
  .flight-plan__log-heading p { margin: 0; font-size: 0.75rem; }
  .flight-plan__table-head,
  .flight-plan__row { display: grid; grid-template-columns: minmax(120px, 0.45fr) minmax(180px, 0.8fr) minmax(0, 1.75fr); gap: 24px; }
  .flight-plan__table-head { padding: 12px 0; border-block: 1px solid var(--rule); font-size: 0.75rem; }
  .flight-plan__row { padding: 22px 0; border-bottom: 1px solid var(--rule); }
  .flight-plan__phase { display: flex; flex-direction: column; gap: 6px; color: var(--accent); font-variant-numeric: tabular-nums; }
  .flight-plan__phase small { color: var(--muted); font-size: 0.75rem; }
  .flight-plan__row h3 { margin: 0 0 5px; font: 500 1.12rem/1.35 var(--display-font); }
  .flight-plan__row div p,
  .flight-plan__row > p { margin: 0; color: var(--muted); font-size: 0.94rem; line-height: 1.6; }
  .flight-plan__row ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .flight-plan__row li { display: flex; flex-wrap: wrap; gap: 5px 12px; align-items: baseline; }
  .flight-plan__row li span { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }

  .flight-plan__footer { max-width: 1160px; margin: 38px auto 0; padding-top: 16px; border-top: 1px solid var(--rule); font-size: 0.75rem; }
  .flight-plan__footer p { margin: 0; }
  .flight-plan__footer span { white-space: nowrap; }

  @media (max-width: 760px) {
    .flight-plan { padding: 18px 22px 104px; }
    .flight-plan__header { align-items: flex-start; flex-direction: column; gap: 8px; }
    .flight-plan__wordmark { max-width: calc(100% - 58px); }
    .flight-plan__header nav { justify-content: flex-start; gap: 0 14px; }
    .flight-plan__hero { grid-template-columns: 1fr; gap: 42px; margin: 58px auto 72px; }
    .flight-plan h1 { font-size: clamp(3.25rem, 16vw, 5.4rem); }
    .flight-plan__status { max-width: 480px; }
    .flight-plan__table-head { display: none; }
    .flight-plan__row { grid-template-columns: 1fr; gap: 9px; padding: 20px 0; }
    .flight-plan__phase { flex-direction: row; align-items: baseline; gap: 10px; }
    .flight-plan__footer { align-items: flex-start; flex-direction: column; gap: 10px; }
  }
</style>
