---
const { contentHtml, navigation } = Astro.props;
---

<section class="home-design poster" data-variant="poster">
  <header class="poster__header">
    <a class="poster__wordmark" href="/">KW<span> / PERSONAL SITE</span></a>
    <nav class="poster__navigation" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={item.href === "/" ? "page" : undefined}>{item.title}</a>
      ))}
    </nav>
  </header>

  <div class="poster__hero">
    <div class="poster__title">
      <p>01 <span>—</span> HOME</p>
      <h1>Home</h1>
    </div>
    <div class="poster__stamp" aria-hidden="true"><span>KW</span><i></i></div>
  </div>

  <article class="poster__content" set:html={contentHtml}></article>
</section>

<style>
  .poster {
    min-height: 100svh;
    padding: 0 clamp(22px, 5vw, 72px) 128px;
    background: var(--canvas);
  }

  .poster__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    min-height: 78px;
    border-block-end: 1px solid var(--rule);
  }

  .poster__wordmark {
    color: var(--ink);
    font: 700 0.82rem/1 var(--body-font);
    letter-spacing: 0.08em;
    text-decoration: none;
    white-space: nowrap;
  }

  .poster__wordmark span {
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .poster__navigation {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 16px;
  }

  .poster__navigation a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font: 500 0.8rem/1.2 var(--body-font);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .poster__navigation a[aria-current="page"] {
    color: var(--accent);
  }

  .poster__hero {
    position: relative;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    min-height: clamp(300px, 43vw, 570px);
    max-width: 1280px;
    margin-inline: auto;
    padding: clamp(40px, 7vw, 92px) 0 38px;
    border-block-end: 1px solid var(--ink);
  }

  .poster__title {
    position: relative;
    z-index: 1;
  }

  .poster__title p {
    margin: 0 0 12px 0.45em;
    color: var(--accent);
    font: 700 0.73rem/1.3 var(--body-font);
    letter-spacing: 0.16em;
  }

  .poster__title p span {
    padding-inline: 0.3em;
    color: var(--muted);
  }

  .poster h1 {
    margin: 0;
    color: var(--ink);
    font: 400 clamp(6rem, 20vw, 18rem)/0.78 var(--display-font);
    letter-spacing: -0.09em;
    text-wrap: balance;
  }

  .poster__stamp {
    position: absolute;
    inset: 14% 6% auto auto;
    display: grid;
    place-items: center;
    width: clamp(110px, 18vw, 220px);
    aspect-ratio: 1;
    border: 1px solid color-mix(in oklch, var(--accent) 58%, transparent);
    border-radius: 50%;
    color: var(--accent);
    font: 400 clamp(2.2rem, 5vw, 4.2rem)/1 var(--display-font);
    letter-spacing: -0.08em;
    pointer-events: none;
    transform: rotate(12deg);
    user-select: none;
  }

  .poster__stamp::before,
  .poster__stamp::after {
    position: absolute;
    inset: 8%;
    border: 1px solid color-mix(in oklch, var(--accent) 42%, transparent);
    border-radius: 50%;
    content: "";
  }

  .poster__stamp::after {
    inset: 18%;
  }

  .poster__stamp i {
    position: absolute;
    width: 1px;
    height: 72%;
    background: color-mix(in oklch, var(--accent) 50%, transparent);
  }

  .poster__content {
    max-width: 1280px;
    margin: 50px auto 0;
    color: var(--ink);
    font: 400 1.04rem/1.7 var(--body-font);
  }

  .poster__content :global(p) {
    max-width: 65ch;
    margin: 0 0 1.5em;
  }

  .poster__content :global(p:first-child) {
    max-width: 50ch;
    font-size: 1.3rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .poster__content :global(h2) {
    margin: 3.25rem 0 1rem;
    padding-block-start: 0.8rem;
    border-block-start: 1px solid var(--rule);
    color: var(--accent);
    font: 400 clamp(1.75rem, 4vw, 2.6rem)/1.1 var(--display-font);
    letter-spacing: -0.045em;
  }

  .poster__content :global(ul) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
    padding: 0;
    list-style: none;
  }

  .poster__content :global(li) {
    padding: 16px 0;
    border-block-start: 1px solid var(--rule);
  }

  .poster__content :global(a) {
    color: var(--accent);
    text-decoration-thickness: from-font;
    text-underline-offset: 0.15em;
  }

  @media (hover: hover) and (pointer: fine) {
    .poster__navigation a:hover {
      color: var(--accent);
    }
  }

  @media (max-width: 720px) {
    .poster {
      padding-inline: 24px;
    }

    .poster__header {
      align-items: flex-start;
      padding-block: 12px;
    }

    .poster__navigation {
      gap: 0 12px;
    }

    .poster__hero {
      min-height: 360px;
      padding-block-end: 24px;
    }

    .poster h1 {
      font-size: clamp(5rem, 21vw, 10rem);
    }

    .poster__stamp {
      inset: 10% 4% auto auto;
    }
  }

  @media (max-width: 520px) {
    .poster__header {
      flex-direction: column;
      justify-content: center;
      gap: 4px;
    }

    .poster__navigation {
      justify-content: flex-start;
    }

    .poster__content :global(ul) {
      grid-template-columns: 1fr;
    }
  }
</style>
